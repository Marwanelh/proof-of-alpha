{
  "name": "proof-of-alpha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A credit record for crypto KOLs: verifiable calls, Edge scored against the market's own expectation, receipts on BNB Chain.",
  "license": "MIT",
  "engines": {
    "node": "^22.20.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "seed": "node scripts/seed.mjs",
    "leaderboard": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/leaderboard.mjs",
    "verify:demo": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/verify-demo.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test": "node scripts/check-secrets.mjs && node scripts/check-boundaries.mjs && node --experimental-strip-types --test tests/core.test.ts tests/verify.test.ts tests/registry.test.ts tests/memory.test.ts tests/answer.test.ts tests/resolve.test.ts",
    "test:verify": "node --env-file-if-exists=.env.local --experimental-strip-types --test tests/verify.test.ts",
    "smoke": "node --env-file-if-exists=.env.local scripts/smoke.mjs",
    "postinstall": "git config core.hooksPath .githooks || true",
    "setup": "git config core.hooksPath .githooks && node scripts/check-secrets.mjs",
    "deploy": "node --env-file-if-exists=.env.local scripts/deploy.mjs",
    "deploy:check": "node --env-file-if-exists=.env.local scripts/deploy.mjs --check",
    "deploy:verified": "node --env-file-if-exists=.env.local scripts/deploy.mjs --verified --check",
    "prove:memory": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/prove-memory.mjs",
    "test:memory": "node --experimental-strip-types --test tests/memory.test.ts",
    "test:resolve": "node --experimental-strip-types --test tests/resolve.test.ts",
    "resolve": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/resolve-due.mjs",
    "resolve:write": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/resolve-due.mjs --write"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "solc": "^0.8.24",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.58.7"
  }
}
