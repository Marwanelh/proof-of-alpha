# Copy to .env — never commit this file. Keys live only in the backend environment.

# --- CoinMarketCap ---------------------------------------------------------
# Required for /v1/content/posts/latest (the call source). Keyless /public-api calls need no key.
CMC_API_KEY=
# Keyless base, no key, IP-rate-limited: https://pro-api.coinmarketcap.com/public-api
CMC_PUBLIC_BASE=https://pro-api.coinmarketcap.com/public-api

# --- Atlas Oracle ---------------------------------------------------------
# The free push feeds live on BSC MAINNET (56). The registry reads the feed, so both must be on the same chain.
# Feed proxy address from https://atlasoracle.io/feeds/{feedId}
ATLAS_FEED_ADDRESS=
# The 4-BYTE on-chain feed id — NOT the catalogue number (passing the catalogue number reverts).
# Ask the Atlas team, or read it off their dashboard. 8 hex chars, e.g. 0x0000048c
ATLAS_FEED_ID=
BSC_RPC=https://bsc-dataseed.binance.org

# --- Chain -----------------------------------------------------------------
# Registry deploys on mainnet (56) for trustless Atlas reads, and on testnet (97) for the gas-free demo.
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Generated by the wallet script; the address is public (faucet), the key stays in .env.local.
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=
CALL_REGISTRY_MAINNET=
CALL_REGISTRY_TESTNET=

# --- LLM (optional) -------------------------------------------------------
# NOT REQUIRED. server/claim.ts is rule-based so the pipeline runs with no LLM key and no network.
# Add one only if you swap the extractor for a model-backed one; then it is server-only.
LLM_API_KEY=
LLM_MODEL=

# --- Cournot ---------------------------------------------------------------
# https://interface.cournot.ai ; 3 free calls per IP in total (no reset), then x402 (Base) / b402 (BNB Chain)
COURNOT_API_BASE=https://interface.cournot.ai
COURNOT_API_KEY=

# --- ChatAndBuild Living Brain --------------------------------------------
# Key looks like lbk_...  A subject id is required: brains are owned by subjects.
LIVING_BRAIN_API_KEY=REDACTED_ROTATE_ME
LIVING_BRAIN_SUBJECT_ID=REDACTED_ROTATE_ME
LIVING_BRAIN_MCP_URL=https://livingbrain.fernmcp.dev/livingbrain

# --- LLM for claim extraction --------------------------------------------
LLM_API_KEY=
LLM_MODEL=
