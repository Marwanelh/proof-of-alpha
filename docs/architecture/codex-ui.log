/**
 * The Builder A -> Builder B contract.
 *
 * Everything here is JSON-safe: no Date, no BigInt, no class instance crosses the boundary.
 * A owns the left of the arrow (VerificationRecord), B owns the right (CallRecord[]) and can
 * run entirely from data/seed.json without importing any of A's modules or credentials.
 *
 * The `never` fields below are deliberate: they make a fabricated probability or a made-up
 * transaction hash a COMPILE-TIME error rather than a code-review convention.
 */

/* ------------------------------------------------------------------ inputs */

export type ClaimSource = "paste" | "cmc";

export type Claim = {
  source: ClaimSource;
  sourcePostId?: string;
  authorId: string;
  originalText: string;
  postedAt: string; // ISO-8601
  asset: string; // uppercase ticker, <= 4 bytes before contract encoding
  direction: "bullish" | "bearish";
  targetUsd: string; // decimal string; scaled only at the contract boundary
  deadline: string; // ISO-8601, strictly after postedAt
  /** True when the post gave no explicit date and we applied the documented default horizon. */
  horizonDefaulted: boolean;
};

export type CmcSnapshot = {
  priceUsd: string;
  observedAt: string;
  requestId?: string;
  /**
   * Which CMC base produced this price. "keyed" is a live Pro API call against the account's key and is
   * what the CMC × Atlas entry asks for; "keyless" is the public base and costs nothing. Recorded so the
   * receipt can show which one it was instead of asserting it.
   */
  source?: "keyed" | "keyless";
};

export type AtlasSnapshot = {
  feedAddress: `0x${string}`;
  feedId: `0x${string}`;
  price: string; // raw uint80 as a decimal string
  decimals: number;
  aggregatedTs: number;
  onchainTs: number;
  mainnetBlock: string; // bigint encoded for JSON
};

export type OnChainReceipt = {
  chainId: 56 | 97;
  registry: `0x${string}`;
  txHash: `0x${string}`;
  callId: string;
  atlasVerified: boolean;
};

/* ------------------------------------------------------- Cournot provenance */

export type CournotProvenance = "live" | "recorded-live" | "fixture";

type CournotResult = {
  probability: number; // finite, in [0, 1]
  evaluatedClaim: string; // shown verbatim
  evidence: string; // shown verbatim
};

/** A real call through the official client. The only kind that may be exported as sponsor proof. */
export type ProvenCournotResponse = CournotResult & {
  provenance: "live" | "recorded-live";
  requestId: string;
  fixtureId?: never;
};

/** Synthetic. Powers development and rehearsal; never sponsor evidence, never on stage as evidence. */
export type FixtureCournotResponse = CournotResult & {
  provenance: "fixture";
  fixtureId: string;
  requestId?: never;
};

export type CournotResponse = ProvenCournotResponse | FixtureCournotResponse;

/* ---------------------------------------------------------------- outcomes  */

export type Resolution = {
  outcome: 0 | 1;
  resolvedAt: string;
  cmcPriceUsd: string;
};

export type CournotScore = {
  kind: "cournot-edge";
  probability: number;
  edge: number;
};

export type ProxyBaseline = {
  probability: number;
  label: "Proxy baseline — not Cournot";
  methodology: string;
};

export type ProxyScore = {
  kind: "proxy-edge";
  label: "Proxy Edge — not Cournot";
  probability: number;
  edge: number;
};

/* ------------------------------------------------------------- the records  */

export type VerificationRecord = {
  kind: "verified";
  id: string;
  claim: Claim;
  cournot: CournotResponse;
  cmc: CmcSnapshot;
  atlas: AtlasSnapshot;
  receipt: OnChainReceipt;
  resolution: null | { result: Resolution; score: CournotScore };
};

export type BacktestedCallRecord = {
  kind: "backtested";
  id: string;
  claim: Claim;
  cmcAtPost: CmcSnapshot;
  proxyBaseline: ProxyBaseline;
  resolution: { result: Resolution; score: ProxyScore };
  cournot?: never;
  receipt?: never;
};

export type CallRecord = VerificationRecord | BacktestedCallRecord;

/* -------------------------------------------------------------------- guards */

/** The single place that decides whether a Cournot result may be presented as evidence. */
export function isSponsorEvidence(
  c: CournotResponse,
): c is ProvenCournotResponse {
  return c.provenance === "live" || c.provenance === "recorded-live";
}

export function isVerifiedRecord(r: CallRecord): r is VerificationRecord {
  return r.kind === "verified";
}

/** Only a verified record has a real transaction to link to. */
export function explorerEligible(r: CallRecord): boolean {
  return r.kind === "verified";
}

/**
 * The verify pipeline: post text -> claim -> Cournot -> snapshots -> on-chain receipt.
 *
 * Every provider is injected. That is what makes the whole money shot testable with no network, no
 * credentials and no chain, and it is why a failing provider fails the test rather than disappearing
 * into a fallback. Failures propagate with context; nothing here invents a value to keep going.
 *
 * The ordering rule that matters: the receipt is written last and must be confirmed. A record is only
 * returned once a real transaction backs it.
 *
 * NOTE: add `import "server-only"` here once the Next app lands.
 */

import type {
  AtlasSnapshot,
  Claim,
  CmcSnapshot,
  CournotResponse,
  OnChainReceipt,
  VerificationRecord,
} from "../shared/types.ts";
import { isSponsorEvidence } from "../shared/types.ts";
import type { CournotMode } from "./cournot.ts";

export class VerifyError extends Error {}

export type ExtractInput = {
  text: string;
  authorId: string;
  postedAt: string;
  source?: "paste" | "cmc";
  sourcePostId?: string;
};

export type VerifyDeps = {
  extract: (input: ExtractInput) => Promise<Claim | null>;
  readCournot: (claim: Claim, mode: CournotMode) => CournotResponse;
  readPrice: (symbol: string) => Promise<CmcSnapshot>;
  readAtlas: () => Promise<AtlasSnapshot>;
  record: (call: RecordCallInput) => Promise<OnChainReceipt>;
};

export type RecordCallInput = {
  claim: Claim;
  cournot: CournotResponse;
  cmc: CmcSnapshot;
  atlas: AtlasSnapshot;
};

export type VerifyOptions = {
  cournotMode: CournotMode;
  /** When false the pipeline stops before the chain and returns the assembled record minus a receipt. */
  record: boolean;
};

export type VerifyResult = {
  record: Omit<VerificationRecord, "receipt"> & { receipt: OnChainReceipt | null };
  /** True when the Cournot number in this record may be cited as sponsor evidence. */
  evidenceEligible: boolean;
};

export async function verify(
  input: ExtractInput,
  deps: VerifyDeps,
  options: VerifyOptions,
): Promise<VerifyResult> {
  const claim = await deps.extract(input);
  if (claim === null) {
    throw new VerifyError(
      "no scorable claim in this post: it needs one asset, a direction, a price target and a future deadline",
    );
  }

  const cournot = deps.readCournot(claim, options.cournotMode);
  const cmc = await deps.readPrice(claim.asset);
  const atlas = await deps.readAtlas();

  if (!options.record) {
    return {
      record: { kind: "verified", id: `draft-${claim.asset}`, claim, cournot, cmc, atlas, receipt: null, resolution: null },
      evidenceEligible: isSponsorEvidence(cournot),
    };
  }

  const receipt = await deps.record({ claim, cournot, cmc, atlas });
  if (!receipt.txHash || !receipt.registry) {
    throw new VerifyError("the recorder returned without a confirmed transaction; refusing to emit a record");
  }
  if (receipt.atlasVerified !== false && receipt.chainId === 97) {
    throw new VerifyError("a testnet receipt must not claim a verified Atlas read — referenced mode is atlasVerified=false");
  }

  return {
    record: {
      kind: "verified",
      id: `call-${receipt.callId}`,
      claim,
      cournot,
      cmc,
      atlas,
      receipt,
      resolution: null,
    },
    evidenceEligible: isSponsorEvidence(cournot),
  };
}


